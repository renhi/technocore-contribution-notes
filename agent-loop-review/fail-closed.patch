+def require_ok(step: str, result: tuple[int, str]) -> tuple[int, str]:
+    """Stop before later writes if this step did not receive HTTP 200."""
+    status, _ = result
+    if status != 200:
+        raise RuntimeError(f"{step}: HTTP {status}; demo stopped without retry")
+    return result
 
 
